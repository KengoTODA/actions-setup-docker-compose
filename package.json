{
  "name": "@kengotoda/actions-setup-docker-compose",
  "version": "1.2.5",
  "description": "the GitHub Action setting up docker-compose command",
  "main": "lib/main.js",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build src/main.ts --source-map",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "all": "pnpm run build && pnpm run format && pnpm run lint && pnpm run package && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KengoTODA/actions-setup-docker-compose.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Kengo TODA <skypencil@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@types/node": "24.10.10",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "@vercel/ncc": "0.45.0",
    "eslint": "9.39.2",
    "eslint-plugin-jest": "29.12.2",
    "jest": "30.2.0",
    "js-yaml": "4.3.1",
    "prettier": "3.8.1",
    "semantic-release": "25.0.3",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "@eslint/js": "9.39.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@semantic-release/npm": "13.1.3",
    "@semantic-release/github": "12.0.2",
    "semver": "7.7.3",
    "@jest/globals": "30.2.0"
  },
  "release": {
    "branches": "main",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/exec",
        {
          "prepare": "pnpm run package"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "dist",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "packageManager": "pnpm@11.25.0"
}
